{
	"name": "pglite-durable-object-template",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "bun run test:workers && bun run test:node",
		"test:workers": "vitest run --config vitest.config.mts",
		"test:node": "vitest run --config vitest.node.config.mts",
		"typecheck": "tsc --noEmit",
		"check": "bun run artifacts:check && bun run typecheck && bun run test:workers && bun run test:node && wrangler deploy --dry-run",
		"artifacts:check": "bun scripts/check-artifacts.mjs",
		"cf-typegen": "wrangler types",
		"wasm:functions": "bun scripts/generate-wasm-function-wrappers.mjs",
		"setup": "git submodule update --init --recursive vendor/pglite && bun run wasm:functions && bun run pglite:build-low-memory",
		"pglite:build-low-memory": "bash scripts/build-pglite-low-memory.sh",
		"pglite:verify-memory": "bun scripts/verify-pglite-memory.mjs src/vendor/pglite/pglite.wasm 64"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.15.2",
		"@types/node": "^25.6.0",
		"typescript": "^5.5.2",
		"vitest": "^4.1.0",
		"wrangler": "^4.87.0"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.4.5",
		"@electric-sql/pglite-prepopulatedfs": "0.0.3",
		"hono": "^4.12.16"
	}
}
